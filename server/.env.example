PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/careersync
JWT_SECRET=change_me_to_a_long_random_string
# Where the React app runs. Several origins can be comma separated. (localhost on any port is always allowed in development)
CLIENT_URL=http://localhost:5173

# ---- Jobs for EVERY profession (strongly recommended): free keys from https://developer.adzuna.com ----
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
# Optional extra searches for the periodic sync (comma separated). Roles that your users target are added automatically.
ADZUNA_QUERY=

GREENHOUSE_BOARDS=airbnb
LEVER_COMPANIES=spotify
MATCH_NOTIFY_THRESHOLD=70
AUTO_SYNC=true
SYNC_INTERVAL_HOURS=12
# GOV_EXTRA='[{"key":"rrb-chennai","name":"RRB Chennai","level":"central","url":"https://..."}]'

# Google Sign-In (create a Web OAuth 2.0 client in Google Cloud Console) – optional
GOOGLE_CLIENT_ID=

# Email alerts for new matching jobs (SMTP; Gmail requires an App Password) – optional
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CareerSync AI <your-email@gmail.com>
